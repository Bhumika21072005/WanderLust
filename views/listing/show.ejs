<% layout("/layouts/boilerplate") %>
<div class="row">
<div class="col-8 offset-3">
    <H3>Listing Details:</H3>
    
 </div>
    <div class="card col-6 show-card offset-3">
        <img src="<%= listings.image.url %>" class="card-img show-img " alt="listing_img">
     <div class="card-body">
        <p class="card-text">
            <b><%= listings.title %></b><br>
            <%=listings.description %> <br>
            &#8377;<%=listings.price.toLocaleString("en-IN") %> <br>
            <%=listings.location %><br>
            <%= listings.country %><br>
        </p>
     </div>
    
    </div>
    
   
    <div class="btns">
    <a href="/listings/<%= listings.id %>/edit" class="btn btn-dark col-1 offset-3"> Edit  </a>
    
    

    <form method="POST" action="/listings/<%= listings._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">Delete</button>
    </form>
    </div>
     

</div>
