<% layout("/layouts/boilerplate") %>
<body>
    <h3>All Listings</h3>
    <!-- <form method="GET" action="/listings/new">
        <button>Create New Listing</button>
    </form> -->

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
 <%for(listing of allListings){ %>
    <a href="/listings/<%= listing.id %>" class="listing-link">
    <div class="card col" >
  <div class="card-body">
    <img src="<%= listing.image.url %>" class="card-img" alt="listing_img" style="height:20rem;">
    <div class="card-img-overlay">abcd</div>
    <p class="card-text"><%= listing.title %>
    <br>
&#8377;<%= listing.price != null
    ? listing.price.toLocaleString("en-IN")
    : "Price not available" %> / night
   </p>
    <small class="fg-3">Last updated 3 mins ago</small>
  </div>
</div>
</a>
 <%} %>
 </div>



</body>
<!-- </html> -->